# Where the model runs (backend/models.yaml; ./setup.sh asks and sets this):
#   tacc-tunnel  Qwen3.8-27B on TACC GPUs, reached through ./run.sh app's SSH tunnel (recommended)
#   local        Qwen3 8B on this machine through Ollama
FJ_MODEL=tacc-tunnel
DATABASE_URL=postgresql+psycopg://flatjai:flatjai@localhost:5432/flatjai
# Self-hosted SearXNG from compose.yaml
SEARXNG_URL=http://localhost:8888
# OpenTripPlanner from compose.yaml (make otp-graph first); leave unset for the offline estimate
OTP_URL=http://localhost:8080
# Per-brief time budget in seconds (most briefs finish in 20 to 70 s; the first read of a page is the slow part)
RUN_MAX_SECONDS=240
