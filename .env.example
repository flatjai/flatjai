# Which model profile to use: local | tacc
FJ_MODEL=local
DATABASE_URL=postgresql+psycopg://flatjai:flatjai@localhost:5432/flatjai
# Self-hosted SearXNG from compose.yaml
SEARXNG_URL=http://localhost:8888
# OpenTripPlanner from compose.yaml (make otp-graph first); leave unset for the offline estimate
OTP_URL=http://localhost:8080
# Per-brief time budget (90 s on TACC; a laptop model needs ~240, which setup.sh sets)
RUN_MAX_SECONDS=90
